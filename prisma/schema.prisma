generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Persistent GlobalRAVE memory — one row per (boardSize, mode) config.
model RaveMemory {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "rave_15_classic"
  boardSize   Int
  gameMode    String
  data        String // JSON payload of GlobalRAVE.toJSON()
  totalVisits Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// History of Quick-Train runs (shown in Settings results list).
model TrainingRun {
  id          String   @id @default(cuid())
  boardSize   Int
  winLength   Int
  gameMode    String
  numGames    Int
  p1Wins      Int
  p2Wins      Int
  draws       Int
  totalMs     Int
  visitsAdded Int
  createdAt   DateTime @default(now())
}
